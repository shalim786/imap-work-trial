# Local sandbox defaults. Separate hosted values may be provided.
# Never commit a real credential.
AGENTMAIL_API_URL=http://127.0.0.1:3210/v0
AGENTMAIL_INBOX_ID=candidate@imap.test
AGENTMAIL_API_KEY=test_agentmail_key

IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_UID_DB=var/uids.sqlite3
IMAP_TEMP_DIR=var/tmp
IMAP_REFRESH_INTERVAL_SECONDS=60
# Shared by all connections using the same API key. Downloads obey its cooldown.
IMAP_API_REQUESTS_PER_SECOND=5
IMAP_DOWNLOAD_CONCURRENCY=2
IMAP_FETCH_GROUP_MESSAGES=8
IMAP_METADATA_GROUP_MESSAGES=256
IMAP_METADATA_AUTH_INTERVAL=60
IMAP_RAW_CACHE_BYTES=67108864
IMAP_RAW_CACHE_TTL=120
IMAP_RETRY_INITIAL=1
IMAP_RETRY_MAX=60
# local = plaintext loopback; implicit = direct TLS; terminated = private TLS-proxy backend
IMAP_TLS_MODE=local
# IMAP_TLS_CERT_FILE=var/tls-test/localhost.crt
# IMAP_TLS_KEY_FILE=var/tls-test/localhost.key

# Enable only when every credential for an inbox has the same full, stable visibility.
IMAP_ASSUME_FULL_VISIBILITY=false

# Keep quiet connections alive through the AWS NLB (350-second TLS idle limit).
IMAP_HEARTBEAT_INTERVAL_SECONDS=120
IMAP_TCP_KEEPALIVE_IDLE=60
IMAP_TCP_KEEPALIVE_INTERVAL=20
IMAP_TCP_KEEPALIVE_COUNT=3
