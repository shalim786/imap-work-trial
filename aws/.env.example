# Non-secret examples. ECS injects the password from Secrets Manager.
AGENTMAIL_API_URL=https://api.agentmail.to/v0
IMAP_STORAGE_BACKEND=postgres
IMAP_HOST=0.0.0.0
IMAP_PORT=1143
IMAP_TLS_MODE=terminated
IMAP_DB_HOST=replace-with-rds-endpoint
IMAP_DB_PORT=5432
IMAP_DB_NAME=imap
IMAP_DB_USER=imap
IMAP_DB_PASSWORD=replace-through-secret-injection
IMAP_DB_SSLMODE=verify-full
IMAP_DB_SSLROOTCERT=/app/certs/global-bundle.pem
IMAP_HEALTH_PORT=8080
IMAP_DRAIN_SECONDS=45
IMAP_TEMP_DIR=/app/var/tmp
# Set true only when inbox credentials can list every relevant protected label.
IMAP_ASSUME_FULL_VISIBILITY=false

# Keep quiet connections alive through the AWS NLB (350-second TLS idle limit).
IMAP_HEARTBEAT_INTERVAL_SECONDS=120
IMAP_TCP_KEEPALIVE_IDLE=60
IMAP_TCP_KEEPALIVE_INTERVAL=20
IMAP_TCP_KEEPALIVE_COUNT=3
